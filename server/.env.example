# SQL Server (the ERP database)
DB_SERVER=localhost
# DB_INSTANCE=MSSQLSERVER01   # only for a named instance
# DB_PORT=1433
DB_NAME=nemsuerppppppppppppp
DB_USER=sa
DB_PASSWORD=change-me
DB_ENCRYPT=false

# Long random string used to sign login tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me

PORT=4000

# App invoices are booked under the rep's own outlet (adm.Companies.MainLoc of the login's company):
# InvoiceNo = INV + MainLoc + rep code (login id, 3 digits) + 6-digit number, made on the phone (see numbers.js).
# MOBILE_MAINLOC is only the old fixed code, still accepted for numbers made offline before the switch.
MOBILE_MAINLOC=MB
MOBILE_STATION=1
MOBILE_LOCATION=BAR
DEFAULT_COMPANY_ID=1
